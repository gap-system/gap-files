[Unit]
Description=Re-verify all mirrored GAP package archives
Documentation=https://github.com/gap-system/gap-files
After=network-online.target

[Service]
Type=oneshot
# --force re-checks every archive even when the package distribution has not
# changed, so that a file which has rotted or been replaced upstream is noticed
# rather than trusted forever.
ExecStart=%h/data/gap-files/bin/mirror-packages.sh --force
